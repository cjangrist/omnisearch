# Omnisearch MCP — Environment Variables
# Secrets are managed via Doppler, NOT .env files.
# This file exists purely as documentation of required/optional env vars.
#
# Sync to Cloudflare Workers:
#   doppler secrets download --no-file --format json | npx wrangler secret bulk
#
# Deploy:
#   CLOUDFLARE_EMAIL=$(doppler secrets get CLOUDFLARE_EMAIL --plain) \
#   CLOUDFLARE_API_KEY=$(doppler secrets get CLOUDFLARE_API_TOKEN --plain) \
#   npx wrangler deploy

# ─── Search Providers (web_search tool) ─────────────────────────────
# At least one is required for the web_search tool to work.
TAVILY_API_KEY=
BRAVE_API_KEY=
KAGI_API_KEY=
EXA_API_KEY=
SERPAPI_API_KEY=
LINKUP_API_KEY=
FIRECRAWL_API_KEY=
YOU_API_KEY=
PARALLEL_API_KEY=
PERPLEXITY_API_KEY=

# ─── Cerebras (web_search snippet grounding via gpt-oss-120b) ───────
# When set, web_search fetches the top-N URLs in parallel (via omnifetch) and uses
# Cerebras's gpt-oss-120b to extract query-grounded snippets from the actual page
# content. Default ON when key is present; callers can opt out per-call with
# grounded_snippets:false.
CEREBRAS_API_KEY=

# ─── omnifetch service (fetch tool + web_search grounding) ─────────
# Base URL of the external omnifetch service that owns ALL URL fetching (the
# multi-provider waterfall, externalized). omnisearch POSTs {url} to
# ${OMNIFETCH_ENDPOINT}/web_fetch. Public endpoint (no auth). Defaults to the
# local docker-compose service (http://127.0.0.1:8000) for dev; override for prod.
#   git clone https://github.com/cjangrist/omnifetch && cd omnifetch && docker compose up -d --build
OMNIFETCH_ENDPOINT=http://127.0.0.1:8000

# ─── REST Endpoints Auth (optional) ───────────────────────────────
OPENWEBUI_API_KEY=
OMNISEARCH_API_KEY=
